# Copie este arquivo para ".env.local" (que já é ignorado pelo git) e
# preencha com os valores reais. Veja o README para o passo a passo de
# onde encontrar cada um.

# --- Supabase ---
# Painel do projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha esta chave no navegador — ela ignora o RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago ---
# NÃO tem variável de ambiente aqui: cada salão conecta a própria conta do
# Mercado Pago pelo painel administrativo (Configurações > Recebimento de
# pagamentos), não por uma credencial global. Veja o README, seção 8.

# --- Aplicação ---
# URL pública onde o site está rodando (usada para montar o webhook do
# Mercado Pago). Em desenvolvimento local use um túnel (ex.: ngrok) porque
# o Mercado Pago precisa alcançar essa URL pela internet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo que protege o endpoint de cron (/api/cron/expire-holds).
# Gere um valor aleatório, ex.: openssl rand -hex 32
CRON_SECRET=

# --- Painel mestre (/painel-mestre) ---
# E-mails (separados por vírgula) que podem acessar a tela de criar novos
# salões. Use o e-mail da SUA conta de login (a mesma que você já usa em
# algum /[slug]/admin — o Supabase Auth é o mesmo banco de usuários).
PLATFORM_ADMIN_EMAILS=
